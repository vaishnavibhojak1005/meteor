{
  "LambdaFunctionConfigurations": [
    {
      "Id": "meteor-raw-upload-quality-check",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:397781772486:function:meteor-quality-check",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "prefix",
              "Value": "raw/"
            }
          ]
        }
      }
    }
  ]
}
